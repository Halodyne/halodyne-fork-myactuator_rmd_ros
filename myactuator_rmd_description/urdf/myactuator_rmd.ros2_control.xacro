<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ros2_control configuration for a given joint -->
  <xacro:macro name="myactuator_rmd_ros2_control" params="name joint_name simulation ifname actuator_id
                                                          velocity_alpha effort_alpha
                                                          torque_constant timeout direction:=1.0
                                                          velocity_min_cutoff:=1.0 velocity_beta:=5.0 velocity_d_cutoff:=1.0">
    <ros2_control name="${name}" type="actuator">
      <hardware>
        <xacro:if value="${simulation}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:unless value="${simulation}">
          <plugin>myactuator_rmd_hardware/MyActuatorRmdHardwareInterface</plugin>
          <!-- The name of the CAN interface -->
          <param name="ifname">${ifname}</param>
          <!-- The id used for the CAN communication -->
          <param name="actuator_id">${actuator_id}</param>
          <!-- Hardware mounting sign: joint_state = direction * raw, motor_cmd = direction * canonical -->
          <param name="direction">${direction}</param>
          <!-- Torque constant of the actuator -->
          <param name="torque_constant">${torque_constant}</param>
          <!-- Low-pass filter constant for velocity -->
          <param name="velocity_alpha">${velocity_alpha}</param>
          <!-- Low-pass filter constant for effort -->
          <param name="effort_alpha">${effort_alpha}</param>
          <!-- Timeout of the actuator -->
          <param name="timeout">${timeout}</param>
          <!-- 1-Euro velocity estimator parameters (used in motion mode) -->
          <param name="velocity_min_cutoff">${velocity_min_cutoff}</param>
          <param name="velocity_beta">${velocity_beta}</param>
          <param name="velocity_d_cutoff">${velocity_d_cutoff}</param>
        </xacro:unless>
      </hardware>
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <!-- Composite motion mode interfaces (claimed together by MotionCommandController) -->
        <command_interface name="motion_p"/>
        <command_interface name="motion_v"/>
        <command_interface name="motion_kp"/>
        <command_interface name="motion_kd"/>
        <command_interface name="motion_tff"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
